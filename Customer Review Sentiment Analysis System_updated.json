    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "\n# Get the incoming item\ndata = _item[\"json\"]\n\n# Get Gemini's response\nraw_sentiment = data.get(\"text\", \"\").strip().lower()\n\n# Allowed sentiments\nsentiments = {\n    \"positive\": \"Positive\",\n    \"negative\": \"Negative\",\n    \"neutral\": \"Neutral\"\n}\n\n# Validate the sentiment\nsentiment = sentiments.get(raw_sentiment)\n\nif sentiment is None:\n    raise ValueError(\"Invalid sentiment: \" + raw_sentiment)\n\n# Return the result\nreturn {\n    \"json\": {\n        **data,\n        \"Sentiment\": sentiment,\n        \"Processed\": \"Yes\"\n    }\n}\n"
      },
